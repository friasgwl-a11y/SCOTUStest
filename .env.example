# Copy to .env and adjust as needed. All values have sane defaults if unset.

# Comma-separated two-digit term codes to track. SCOTUS terms are named by
# the year they begin (October) -- "25" = October Term 2025.
SCOTUS_TERMS=25,24

# How often (minutes) the background scheduler re-fetches the Court's site.
SCOTUS_FETCH_INTERVAL_MINUTES=180

# Run one fetch immediately on server startup.
SCOTUS_FETCH_ON_STARTUP=true

# Where the SQLite database file lives.
SCOTUS_DATA_DIR=./data

# Optional: set to enable Claude-generated abstractive summaries instead of
# the built-in offline extractive summarizer. Get a key at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Polite defaults for scraping supremecourt.gov -- please don't lower the
# delay/timeout in a way that would hammer the site.
SCOTUS_REQUEST_DELAY_SECONDS=1.0
SCOTUS_REQUEST_TIMEOUT=30

# --- Memory tuning (matters on small/free hosting tiers) ---
# Only documents released within this many days are summarized in the
# background; older ones are summarized on demand when opened. Set to 0
# to make summarization fully on-demand.
SCOTUS_AUTO_PROCESS_DAYS=1
# Max PDFs processed per background run, per document type.
SCOTUS_DOCUMENT_LIMIT=4
# Pages read per PDF (the syllabus and holding are at the front).
SCOTUS_MAX_PDF_PAGES=20
# Cap on extracted text stored per document.
SCOTUS_MAX_STORED_TEXT_CHARS=120000

# How often (hours) to re-fetch term-level data: the current-term label,
# the Granted & Noted List, and the argument calendars. This changes far
# less often than opinions/orders, so it's cached aggressively.
SCOTUS_TERM_DATA_REFRESH_HOURS=12
